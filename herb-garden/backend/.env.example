# Copy to backend/.env and fill in. The .env file is gitignored.
# These are the only credentials the frontend depends on; the browser
# never sees the AIO key.

AIO_USERNAME=your-adafruit-io-username
AIO_KEY=aio_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override feed slugs if you've named yours differently in
# Adafruit IO. Defaults below match the firmware's expectations.
# AIO_FEED_MOISTURE=soil-moisture
# AIO_FEED_TEMPERATURE=temperature
# AIO_FEED_HUMIDITY=humidity
# AIO_FEED_LIGHT=light-level
# AIO_FEED_RESERVOIR=water-reservoir
# AIO_FEED_PUMP_STATUS=pump-status
# AIO_FEED_WATER_COMMAND=water-command
# AIO_FEED_SELECTED_HERB=selected-herb

# Server bind. Default 127.0.0.1:8000.
# HOST=127.0.0.1
# PORT=8000
# FLASK_DEBUG=0
